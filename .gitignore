# Dependencies (installed inside the image)
node_modules/

# Environment files from local runs: never versioned
.env
.env.*

# Logs (also Terraform's crash.log)
*.log
npm-debug.log*

# OS and editor files
.DS_Store
.vscode/
.idea/

# Local course materials and notes
docs/apuntes/
*.pdf

# Submission bundle (generated by make dist)
dist/
*.zip

# Terraform: provider cache, and the state with its lock. The state holds
# every generated password in plain text.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plans also contain every value in plain text
tfplan
*.tfplan

# Secrets (e.g. the Telegram bot token) go in secrets.auto.tfvars, which
# Terraform loads automatically and is never versioned. Every other setting
# lives in terraform.tfvars, which IS versioned: an environment must be
# deployable from a fresh clone.
secrets.auto.tfvars
secrets.auto.tfvars.json
*.secret.tfvars

# Terraform CLI configuration, which can hold registry credentials
.terraformrc
terraform.rc

# Service configs rendered by Terraform at apply time; they can contain secrets.
.generated/

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
