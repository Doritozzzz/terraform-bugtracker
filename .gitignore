# Dependencies
node_modules/

# Environment secrets: never versioned
.env
.env.*

# Logs
*.log
npm-debug.log*

# Generated deliverables
*.zip

# OS and editor files
.DS_Store
.vscode/
.idea/
*.pdf
# Submission bundle (generated)
dist/

# Local course materials and notes
docs/apuntes/

# Terraform: provider cache, state and its lock (the state holds secrets in plain text)
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Saved plans also contain every value in plain text
tfplan
*.tfplan

# Secrets go in secrets.auto.tfvars (loaded automatically, never versioned).
# terraform.tfvars only holds non-secret settings, so it IS versioned.
secrets.auto.tfvars
*.secret.tfvars

# Files rendered by Terraform at apply time (e.g. the HAProxy config)
.generated/

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
