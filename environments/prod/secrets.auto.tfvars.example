# Copy to secrets.auto.tfvars (ignored by git) to send prod alerts to Telegram
# too. Without it they are only emailed to the test mailbox.
# 1. In Telegram, ask @BotFather for /newbot and copy the token it gives.
# 2. Open the new bot and send it any message.
# 3. Its chat ID is message.chat.id in https://api.telegram.org/bot<token>/getUpdates
telegram_bot_token = "123456789:replace-with-the-bot-token"
telegram_chat_id   = 123456789
