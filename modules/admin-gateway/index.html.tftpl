<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin · ${title}</title>
<style>
  /* Light theme only. No web fonts or scripts: the page is served from
     HAProxy's memory and must stay small and self-contained. */
  :root {
    --bg: #f6f7f9; --surface: #fff; --border: #e4e7ec; --border-hover: #c9ced6;
    --text: #101828; --muted: #667085; --accent: #2563eb;
    font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--text);
  }
  body { margin: 0; background: var(--bg); }
  .bar { background: var(--surface); border-bottom: 1px solid var(--border); }
  .bar div, main { max-width: 1040px; margin: 0 auto; padding: 0 24px; }
  .bar div { display: flex; align-items: center; gap: 10px; height: 56px; }
  .bar b { font-size: 15px; }
  .bar small { margin-left: auto; color: var(--muted); }
  .env { padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; background: #eff4ff; color: #1d4ed8; }
  .env.prod { background: #fef3f2; color: #b42318; }
  main { padding-top: 32px; padding-bottom: 48px; }
  h1 { margin: 0; font-size: 22px; font-weight: 600; }
  .lead { margin: 4px 0 0; color: var(--muted); }
  h2 { margin: 32px 0 12px; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  a { display: flex; gap: 14px; height: 100%; box-sizing: border-box; padding: 18px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; color: inherit; text-decoration: none; box-shadow: 0 1px 2px rgb(16 24 40 / .04); transition: border-color .15s, box-shadow .15s, transform .15s; }
  a:hover, a:focus-visible { border-color: var(--border-hover); box-shadow: 0 6px 16px rgb(16 24 40 / .08); transform: translateY(-1px); outline: none; }
  .icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; color: #fff; font-weight: 700; font-size: 17px; text-transform: uppercase; }
  .icon.logo { background: var(--bg); border: 1px solid var(--border); box-sizing: border-box; }
  .icon img { width: 24px; height: 24px; }
  strong { display: block; font-size: 15px; font-weight: 600; text-transform: capitalize; }
  a:hover strong { color: var(--accent); }
  .desc { display: block; margin-top: 2px; color: var(--muted); }
  code { display: inline-block; margin-top: 10px; padding: 1px 6px; border-radius: 6px; background: var(--bg); color: var(--muted); font: 12px ui-monospace, Menlo, Consolas, monospace; }
</style>
</head>
<body>
<header class="bar"><div>
  <b>${title}</b>
%{ if environment != null ~}
  <span class="env ${environment}">${environment}</span>
%{ endif ~}
  <small>Signed in as ${user}</small>
</div></header>
<main>
  <h1>Admin tools</h1>
  <p class="lead">Everything that runs this environment. Tools with their own login ask for it again.</p>
%{ for g in groups ~}
%{ if g != null ~}
  <h2>${g}</h2>
%{ endif ~}
  <ul>
%{ for i, r in routes ~}
%{ if r.group == g ~}
    <li><a href="${r.path_prefix}">
%{ if r.icon != null ~}
      <span class="icon logo"><img src="${r.icon}" alt=""></span>
%{ else ~}
      <span class="icon" style="background:${colors[i % length(colors)]}">${substr(r.name, 0, 1)}</span>
%{ endif ~}
      <span><strong>${r.name}</strong>%{ if r.description != null }<span class="desc">${r.description}</span>%{ endif }<code>${r.path_prefix}</code></span>
    </a></li>
%{ endif ~}
%{ endfor ~}
  </ul>
%{ endfor ~}
</main>
</body>
</html>
