<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin · ${title}</title>
<style>
  /* Same design tokens as the app's styles.css (light theme only). No web
     fonts or scripts: the page is served from HAProxy's memory and must stay
     small and self-contained. */
  :root {
    color-scheme: light;
    --bg: #fafafa; --surface: #ffffff; --surface-2: #f4f4f5;
    --border: #e4e4e7; --border-strong: #d4d4d8;
    --text: #18181b; --muted: #52525b; --accent: #2563eb; --err: #b91c1c;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    --text-xs: 0.75rem; --text-sm: 0.8125rem; --text-base: 0.875rem; --text-lg: 1.25rem;
    --leading-xs: 1rem; --leading-base: 1.25rem; --leading-lg: 1.75rem;
    --weight-medium: 500; --weight-semibold: 600;
    --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem;
    --space-6: 1.5rem; --space-8: 2rem; --space-12: 3rem;
    --radius-sm: 6px; --radius-md: 8px; --line: 1px; --line-thick: 2px;
    --content-width: 72rem; --gutter: var(--space-6);
    /* Same height as the app's top bar: 32px controls plus 12px above and below. */
    --bar-height: 3.5rem;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: var(--text-base)/var(--leading-base) var(--font); }
  h1, h2, p, ul { margin: 0; padding: 0; }

  /* Top bar and column match the app, so both pages line up. */
  .bar { background: var(--surface); border-bottom: var(--line) solid var(--border); }
  .bar div, main { max-width: var(--content-width); margin: 0 auto; padding-inline: var(--gutter); }
  .bar div { display: flex; align-items: center; gap: var(--space-3); height: var(--bar-height); }
  .bar b { font-weight: var(--weight-semibold); }
  .bar small { margin-left: auto; color: var(--muted); font-size: var(--text-sm); }
  .env {
    margin-left: var(--space-2); padding: 0 var(--space-2); line-height: var(--space-6);
    border: var(--line) solid var(--border-strong); border-radius: var(--radius-sm);
    color: var(--muted); font-size: var(--text-xs); font-weight: var(--weight-medium);
  }
  .env.prod { border-color: var(--err); color: var(--err); }

  main { padding-block: var(--space-8) var(--space-12); }
  h1 { font-size: var(--text-lg); line-height: var(--leading-lg); font-weight: var(--weight-semibold); }
  .lead { margin-top: var(--space-1); color: var(--muted); font-size: var(--text-sm); }
  h2 { margin: var(--space-8) 0 var(--space-3); font-size: var(--text-base); font-weight: var(--weight-semibold); }

  /* One card per tool: a bordered link, no shadow or lift. */
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: var(--space-4); list-style: none; }
  a {
    display: flex; gap: var(--space-3); height: 100%; padding: var(--space-4);
    background: var(--surface); border: var(--line) solid var(--border); border-radius: var(--radius-md);
    color: inherit; text-decoration: none;
  }
  a:hover { border-color: var(--border-strong); background: var(--surface-2); }
  a:focus-visible { outline: var(--line-thick) solid var(--accent); outline-offset: var(--line-thick); }
  .icon {
    flex: none; display: grid; place-items: center; width: var(--space-8); height: var(--space-8);
    background: var(--surface); border: var(--line) solid var(--border); border-radius: var(--radius-sm);
    color: var(--muted); font-weight: var(--weight-semibold); text-transform: uppercase;
  }
  .icon img { width: var(--space-6); height: var(--space-6); }
  strong { display: block; font-weight: var(--weight-semibold); text-transform: capitalize; }
  .desc { display: block; margin-top: var(--space-1); color: var(--muted); font-size: var(--text-sm); }
  code { display: block; margin-top: var(--space-2); color: var(--muted); font: var(--text-xs)/var(--leading-xs) var(--mono); }

  @media (max-width: 40rem) { :root { --gutter: var(--space-4); } }
</style>
</head>
<body>
<header class="bar"><div>
  <b>${title}</b>
%{ if environment != null ~}
  <span class="env ${environment}">${environment}</span>
%{ endif ~}
  <small>Signed in as ${user}</small>
</div></header>
<main>
  <h1>Admin tools</h1>
  <p class="lead">Everything that runs this environment. Tools with their own login ask for it again.</p>
%{ for g in groups ~}
%{ if g != null ~}
  <h2>${g}</h2>
%{ endif ~}
  <ul>
%{ for r in routes ~}
%{ if r.group == g ~}
    <li><a href="${r.path_prefix}">
%{ if r.icon != null ~}
      <span class="icon"><img src="${r.icon}" alt=""></span>
%{ else ~}
      <span class="icon">${substr(r.name, 0, 1)}</span>
%{ endif ~}
      <span><strong>${r.name}</strong>%{ if r.description != null }<span class="desc">${r.description}</span>%{ endif }<code>${r.path_prefix}</code></span>
    </a></li>
%{ endif ~}
%{ endfor ~}
  </ul>
%{ endfor ~}
</main>
</body>
</html>
