global
  # Request logs go to stdout so Docker (and the log collector) picks them up,
  # instead of the default syslog socket that does not exist in a container.
  # Events such as a server going DOWN are already printed once on stderr with
  # their level, so only the frontend below uses this log.
  log stdout format raw local0

# Docker's embedded DNS. Replicas get a new IP every time they are recreated;
# without this HAProxy would keep the address it resolved at startup.
resolvers docker
  nameserver dns 127.0.0.11:53

defaults
  mode http

  # HAProxy has no default timeouts: without them a stuck connection stays open forever.
  # Connect: inside the Docker network a live server accepts in well under a
  # millisecond, so 1s only expires when the server is gone, and the request
  # is then retried on another one. The 4-5s the manual suggests covers packet
  # loss on real networks; here it made every request sent to a stopped
  # replica wait 5s (measured).
  timeout connect 1s
  timeout client 30s
  timeout server 30s

  # Every server is health checked and resolved through Docker's DNS.
  # init-addr none lets HAProxy start even if a replica does not exist yet.
  # observe layer4 also watches real traffic: the first failed connection
  # marks the server down at once, instead of users being sent to it until
  # three health checks fail (up to 6s).
  default-server check resolvers docker init-addr none observe layer4 error-limit 1 on-error mark-down

frontend web
  bind :${listen_port}

  # Every request gets a random ID (UUID v4). It replaces any X-Request-ID the
  # client sent, is passed to the backend so its logs can include it, and is
  # returned to the client. http-after-response also covers the errors
  # HAProxy generates itself, such as a 503 when no replica is up.
  unique-id-format %[uuid()]
  http-request set-header X-Request-ID %[unique-id]
  http-after-response set-header X-Request-ID %[unique-id]

  # One JSON line per request, including which replica served it and the
  # request ID, so the log platform can filter by any field without parsing.
  # The doubled % before { is Terraform's template escape; HAProxy gets one.
  log global
  log-format "%%{+json}o %(time)[accept_date(ms),ms_utime('%Y-%m-%dT%H:%M:%S.%3NZ')] %(requestId)ID %(clientIp)ci %(method)HM %(uri)HU %(status)ST %(bytes)B %(backend)b %(server)s %(responseMs)Tr %(durationMs)Ta %(termination)ts"

  # Lets clients (and tests) see which replica answered.
  http-response set-header X-Served-By %[srv_name]
  # Path-based routing: a request whose path starts with a route prefix goes
  # to that route's backend; everything else goes to the application.
%{ for route in routes ~}
  use_backend ${route.name} if { path_beg ${route.path_prefix} }
%{ endfor ~}
  default_backend app

backend app
  balance ${balance}
  # Active check against the liveness endpoint: a replica that stops
  # answering is taken out of rotation before users hit it. Sent as HTTP/1.1
  # with a Host header: the legacy form (option httpchk GET <path>) sends
  # HTTP/1.0 without one, which strict servers such as MinIO reject with 400.
  option httpchk
  http-check send meth GET uri ${health_path} ver HTTP/1.1 hdr Host localhost
  # If a connection to a replica fails, the last retry goes to another one.
  option redispatch
%{ for backend in backends ~}
  server ${split(":", backend)[0]} ${backend}
%{ endfor ~}
%{ for route in routes ~}

# Extra backend for the ${route.path_prefix} route, health checked like the replicas.
backend ${route.name}
  option httpchk
  http-check send meth GET uri ${route.health_path} ver HTTP/1.1 hdr Host localhost
%{ for server in route.servers ~}
  server ${split(":", server)[0]} ${server}
%{ endfor ~}
%{ endfor ~}

# Internal port, not published to the host: Prometheus scrapes /metrics and
# the container healthcheck calls /healthz.
frontend metrics
  bind :${metrics_port}
  monitor-uri /healthz
  http-request use-service prometheus-exporter if { path /metrics }
